%% ---------------------------------------------------------------- capa e colofão
\newcommand\capa{%
  \begin{titlepage}
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture, overlay]
    \fill[fundo] (current page.south west) rectangle (current page.north east);
    \fill[destaque] (current page.north west) rectangle ([xshift=34mm]current page.south west);
    \fill[destaque2] ([xshift=34mm]current page.north west) rectangle ([xshift=35.2mm]current page.south west);
    \node[rotate=90, anchor=center, text=destaque!55!white, font=\EBfgrego\fontsize{40}{40}\selectfont]
      at ([xshift=17mm]current page.west) {\ebIncipit};
    \node[anchor=north west, text width=128mm, align=left] at ([xshift=52mm, yshift=-42mm]current page.north west) {%
      {\EBfversal\normalsize\color{destaque2!85!black}\ebSerie\ifdefempty{\ebNumero}{}{\ \textbullet\ nº\,\ebNumero}}\\[20mm]
      {\EBftitulo\fontsize{44}{50}\selectfont\color{tinta}\hyphenpenalty=10000\exhyphenpenalty=10000\spaceskip=.3em plus .1em\relax\ebTitulo}\\[8mm]
      {\color{destaque2}\rule{60mm}{.8pt}}\\[7mm]
      {\fontsize{17}{22}\selectfont\itshape\color{tinta!85}\ebSubtitulo}\\[16mm]
      {\EBfgrego\fontsize{17}{22}\selectfont\color{grego}\ebIncipit}};
    \node[anchor=south west] at ([xshift=52mm, yshift=40mm]current page.south west) {\EBemblema[1.1]};
    \node[anchor=south west, align=left] at ([xshift=52mm, yshift=22mm]current page.south west)
      {{\EBfversal\large\color{tinta}\ebAutor}\\[2pt]{\sffamily\small\color{suave}\ebData}};
  \end{tikzpicture}
  \end{titlepage}}

