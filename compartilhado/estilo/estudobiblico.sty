% textos em outras línguas (use também diretamente: o babel troca a fonte sozinho)
\DeclareRobustCommand\gr[1]{\leavevmode{\color{grego}\foreignlanguage{ancientgreek}{#1}}}
\DeclareRobustCommand\hb[1]{\leavevmode{\color{hebraico}\foreignlanguage{hebrew}{#1}}}
\DeclareRobustCommand\arc[1]{\leavevmode{\color{aramaico}\foreignlanguage{hebrew}{#1}}}
\DeclareRobustCommand\sy[1]{\leavevmode{\color{aramaico}\foreignlanguage{syriac}{#1}}}
\DeclareRobustCommand\en[1]{\leavevmode{\color{ingles}\foreignlanguage{english}{\itshape #1}}}
\DeclareRobustCommand\tl[1]{{\EBftranslit\mdseries #1}}
\DeclareRobustCommand\trgr[1]{\tl{\directlua{tex.sprint(EB.translit_grc("\luaescapestring{#1}"))}}}
\DeclareRobustCommand\rb[1]{\textsf{\small #1}}          % referência bíblica em linha: \rb{Lc 1:41}
% nunca passar para maiúsculas (rótulos das caixas, cabeçalhos)
\ExplSyntaxOn
\tl_put_right:Nn \l_text_case_exclude_arg_tl { \gr \hb \arc \sy \en \tl \trgr \rb }
\ExplSyntaxOff

