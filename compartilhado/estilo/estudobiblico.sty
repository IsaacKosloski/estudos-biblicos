\newcommand\EB@tema[6]{% destaque, destaque2, rubrica, fundo, fundo2, fundo-página
  \definecolor{destaque}{HTML}{#1}\definecolor{destaque2}{HTML}{#2}%
  \definecolor{rubrica}{HTML}{#3}\definecolor{fundo}{HTML}{#4}%
  \definecolor{fundo2}{HTML}{#5}\definecolor{fundopagina}{HTML}{#6}}
