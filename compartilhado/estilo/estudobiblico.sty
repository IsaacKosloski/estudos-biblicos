%% ---------------------------------------------------------------- ornamentos
\newcommand\EBlosango[1][destaque2]{\tikz[baseline=-.6ex]\fill[#1] (0,0) -- (.08,.08) -- (.16,0) -- (.08,-.08) -- cycle;}
\newcommand\EBornamento[1][.55\linewidth]{%
  \par\noindent\begin{tikzpicture}[baseline=0]
    \draw[destaque2, line width=.5pt] (0,0) -- (#1/2-.25cm,0);
    \fill[destaque2] (#1/2,0) ++(-.16,0) -- ++(.16,.09) -- ++(.16,-.09) -- ++(-.16,-.09) -- cycle;
    \draw[destaque2, line width=.5pt] (#1/2+.25cm,0) -- (#1,0);
  \end{tikzpicture}\par}
% Emblema: lâmpada de azeite (Sl 119:105)
\newcommand\EBemblema[1][1]{%
  \begin{tikzpicture}[scale=#1, line cap=round, line join=round]
    \fill[destaque2] (1.62,.52) .. controls (1.40,.78) and (1.47,1.06) .. (1.66,1.36)
                     .. controls (1.80,1.08) and (1.90,.80) .. (1.62,.52) -- cycle;
    \fill[destaque2!45!white] (1.63,.60) .. controls (1.52,.76) and (1.56,.93) .. (1.65,1.08)
                     .. controls (1.73,.92) and (1.77,.76) .. (1.63,.60) -- cycle;
    \fill[destaque] (-.95,.18) .. controls (-.95,.62) and (.85,.66) .. (1.18,.47)
        -- (1.66,.50) .. controls (1.80,.45) and (1.78,.28) .. (1.62,.25)
        -- (1.10,.10) .. controls (.88,-.34) and (-.62,-.38) .. (-.95,.18) -- cycle;
    \draw[destaque, line width=2.4pt*#1] (-.90,.30) .. controls (-1.42,.42) and (-1.44,-.06) .. (-.84,.02);
    \fill[destaque] (-.28,-.24) rectangle (.52,-.33);
    \fill[fundo] (.12,.40) ellipse (.19 and .065);
  \end{tikzpicture}}

%% ---------------------------------------------------------------- títulos (titlesec)
\RequirePackage{titlesec}
\addto\captionsbrazilian{\renewcommand\chaptername{Etapa}\renewcommand\partname{Parte}
  \renewcommand\contentsname{Sumário}\renewcommand\indexname{Índice remissivo}}
\renewcommand\chaptername{Etapa}

\newcommand\EB@fundopagina[1][fundo]{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[#1] (current page.south west) rectangle (current page.north east);
  \end{tikzpicture}}

% pinta o fundo da página que está sendo composta (sem material horizontal)
\newcommand\EB@fundoproxima[1][fundo]{\AddToHookNext{shipout/background}{%
  \setlength\unitlength{1pt}\put(0,\strip@pt\dimexpr-\paperheight\relax){{\color{#1}\rule{\paperwidth}{\paperheight}}}}}

% Parte: página inteira colorida, numeral romano grande
\titleformat{\part}[display]
  {\thispagestyle{empty}\EB@fundoproxima\centering}
  {\vspace*{.12\textheight}{\EBfversal\large\color{destaque2}\partname}\\[6pt]
   {\EBftitulo\fontsize{72}{72}\selectfont\color{destaque}\thepart}}
  {18pt}
  {\EBornamento[.35\linewidth]\vspace{14pt}\EBftitulo\fontsize{26}{32}\selectfont\color{tinta}}
  [{\vspace{10pt}\EBornamento[.35\linewidth]}]

% Etapa (capítulo)
\titleformat{\chapter}[display]
  {\normalfont\raggedright}
  {{\EBfversal\normalsize\color{destaque}\chaptertitlename\ \thechapter}}
  {6pt}
  {\EBftitulo\fontsize{25}{30}\selectfont\color{tinta}}
  [\vspace{6pt}{\color{destaque2}\titlerule[.6pt]}]
\titleformat{name=\chapter, numberless}[display]
  {\normalfont\raggedright}{}{0pt}
  {\EBftitulo\fontsize{25}{30}\selectfont\color{tinta}}
  [\vspace{6pt}{\color{destaque2}\titlerule[.6pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{26pt}

\titleformat{\section}
  {\normalfont\sffamily\large\bfseries\color{tinta}}
  {\llap{\color{destaque}\EBfnumeros\bfseries\thesection\hspace{.9em}}}{0pt}{}
\titleformat{\subsection}
  {\normalfont\sffamily\bfseries\color{destaque}}
  {\llap{\thesubsection\hspace{.9em}}}{0pt}{}
\titleformat{\subsubsection}
  {\normalfont\itshape\bfseries\color{tinta}}{}{0pt}{}
\titlespacing*{\section}{0pt}{18pt plus 4pt minus 2pt}{8pt plus 2pt}
\titlespacing*{\subsection}{0pt}{14pt plus 3pt minus 2pt}{5pt plus 2pt}
\titlespacing*{\subsubsection}{0pt}{10pt plus 2pt}{4pt}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

%% ---------------------------------------------------------------- sumário
\RequirePackage{titletoc}
\contentsmargin{2.2em}
\titlecontents{part}[0pt]
  {\addvspace{16pt}\sffamily\bfseries\color{destaque}}
  {\MakeUppercase{\partname}~\thecontentslabel\quad}{}{\hfill\contentspage}[\addvspace{4pt}]
\titlecontents{chapter}[3.4em]
  {\addvspace{9pt}\EBftitulo\large}
  {\contentslabel[{\color{destaque2}\EBfnumeros\thecontentslabel}]{2.6em}}
  {\hspace*{-2.6em}}
  {\hfill\sffamily\small\color{suave}\contentspage}
\titlecontents{section}[5.6em]
  {\addvspace{1pt}\small}
  {\contentslabel[\sffamily\color{suave}\thecontentslabel]{2.2em}}{}
  {\titlerule*[.6pc]{\color{fundo2}.}\sffamily\color{suave}\contentspage}

