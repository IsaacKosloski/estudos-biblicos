%% ---------------------------------------------------------------- fontes e línguas
\RequirePackage{fontspec}
\RequirePackage[bidi=basic]{babel}
\babelprovide[main, import]{brazilian}
\babelprovide[import]{english}
\babelprovide[import, onchar=ids fonts]{ancientgreek}
\babelprovide[import, onchar=ids fonts]{hebrew}
\babelprovide[import, onchar=ids fonts]{syriac}

% Pasta das fontes: "fontes/" ao lado da pasta "estilo/" (vale para o projeto do
% Overleaf e para o repositório, onde estilo/ fica em compartilhado/).
\edef\EB@dir{\directlua{
  local sty = kpse.find_file("estilo/estudobiblico.sty", "tex") or "estilo/estudobiblico.sty"
  local base = sty:gsub("estilo/estudobiblico[.]sty$", "")
  tex.sprint(base .. "fontes/")}}
% texto: EB Garamond | títulos: Marcellus | rótulos: Source Sans 3
\babelfont{rm}[Path=\EB@dir, Extension=.otf, UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic, Numbers=OldStyle]{EBGaramond}
\babelfont{sf}[Path=\EB@dir, Extension=.otf, UprightFont=*-Regular, ItalicFont=*-It,
  BoldFont=*-Semibold, BoldItalicFont=*-SemiboldIt, Scale=MatchLowercase]{SourceSans3}
% grego: Gentium Book Plus | hebraico/aramaico: Noto Serif Hebrew | siríaco: Noto Sans Syriac
\babelfont[ancientgreek]{rm}[Path=\EB@dir, Extension=.ttf, UprightFont=*-Regular,
  ItalicFont=*-Italic, BoldFont=*-Bold, Scale=MatchLowercase]{GentiumBookPlus}
\babelfont[hebrew]{rm}[Path=\EB@dir, Extension=.ttf, UprightFont=*-Regular,
  BoldFont=*-Bold, Scale=1.05]{NotoSerifHebrew}
\babelfont[syriac]{rm}[Path=\EB@dir, Extension=.ttf, UprightFont=*-Regular,
  Scale=1.1]{NotoSansSyriac}

\newfontfamily\EBfgrego{GentiumBookPlus}[Path=\EB@dir, Extension=.ttf,
  UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-Bold]
\newfontfamily\EBftranslit{GentiumBookPlus}[Path=\EB@dir, Extension=.ttf,
  UprightFont=*-Italic, BoldFont=*-Bold]
\newfontfamily\EBfhebraico{NotoSerifHebrew}[Path=\EB@dir, Extension=.ttf,
  UprightFont=*-Regular, BoldFont=*-Bold, Script=Hebrew, Renderer=HarfBuzz]
\newfontfamily\EBfsiriaco{NotoSansSyriac}[Path=\EB@dir, Extension=.ttf,
  UprightFont=*-Regular, Script=Syriac, Renderer=HarfBuzz]
\newfontfamily\EBfsiriacoOriental{NotoSansSyriacEastern}[Path=\EB@dir, Extension=.ttf,
  UprightFont=*-Regular, Script=Syriac, Renderer=HarfBuzz]
\newfontfamily\EBftitulo{Marcellus}[Path=\EB@dir, Extension=.ttf, UprightFont=*-Regular]
