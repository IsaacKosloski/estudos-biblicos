%% ---------------------------------------------------------------- abas laterais
\g@addto@macro\frontmatter{\setcounter{secnumdepth}{-1}}
\g@addto@macro\mainmatter{\setcounter{secnumdepth}{2}}
\newif\ifEB@principal
\g@addto@macro\mainmatter{\global\EB@principaltrue}
\g@addto@macro\backmatter{\global\EB@principalfalse}
\newlength\EB@abaalt \setlength\EB@abaalt{20mm}
\newlength\EB@abalarg \setlength\EB@abalarg{7mm}
\def\EB@abacont{chapter}
\ifdefstring{\ebAbasPor}{parte}{\def\EB@abacont{part}}{}
\newcommand\EB@aba{%
  \ifEB@principal\ifnum\value{\EB@abacont}>0
    \begingroup
      \dimen0=\dimexpr 36mm + (\EB@abaalt+2mm)*\numexpr\value{\EB@abacont}-1\relax\relax
      \ifodd\value{page}\dimen2=\dimexpr\paperwidth-\EB@abalarg\relax\else\dimen2=0pt\fi
      \dimen4=\dimexpr-\dimen0-\EB@abaalt\relax
      \put(\strip@pt\dimen2,\strip@pt\dimen4){{%
        \color{destaque}\rule{\EB@abalarg}{\EB@abaalt}%
        \llap{\raisebox{.5\EB@abaalt}{\makebox[\EB@abalarg]{\color{white}\sffamily\bfseries\small\arabic{\EB@abacont}}}}}}%
    \endgroup
  \fi\fi}
\ifdefstring{\ebAbas}{sim}{%
  \AddToHook{shipout/background}{\setlength\unitlength{1pt}\EB@aba}}{}
\ifdefstring{\ebFundoPagina}{sim}{\pagecolor{fundopagina}}{}

%% ---------------------------------------------------------------- versículos e notas
\newcommand\vs[1]{\textsuperscript{\EBfnumeros\bfseries\color{rubrica}#1}\,}
\newcommand\margem[1]{\marginnote{\RaggedRight\sffamily\footnotesize\color{suave}#1}}
\newcommand\EBimplicito[1]{{\color{suave}#1}}
\newcommand\poema{\par\noindent\hangindent=1.5em\hangafter=1}

%% ---------------------------------------------------------------- caixas (tcolorbox)
\tcbset{EB/base/.style={enhanced, breakable, arc=1.5pt, boxrule=0pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt, before skip=10pt, after skip=10pt,
    fonttitle=\sffamily\bfseries\small}}
\newcommand\EB@rotulo[2]{{\sffamily\bfseries\footnotesize\color{#1}\MakeUppercase{#2}}}

% Objetivo da etapa
\newtcolorbox{objetivo}[1][]{EB/base, colback=fundo, borderline west={3pt}{0pt}{destaque2},
  before upper={\EB@rotulo{destaque2!80!black}{Objetivo}\quad}, #1}

% Tradução bíblica: \begin{traducao}{SIGLA}{Nome completo}{ano} ... \basetextual{AT}{NT} \end{traducao}
\newcommand\EBselo[1]{\tikz[baseline=(s.base)]\node[fill=destaque, text=white, rounded corners=2pt,
  inner xsep=4pt, inner ysep=2pt, font=\sffamily\bfseries\scriptsize](s){#1};}
\newtcolorbox{traducao}[3]{EB/base, colback=white, colframe=fundo2, boxrule=.6pt,
  colbacktitle=fundo, coltitle=tinta, toptitle=3pt, bottomtitle=3pt,
  title={\EBselo{#1}\hspace{.6em}#2\hfill{\color{suave}\mdseries #3}},
  before upper={\index{Traduções!#2 (#1)}\raggedright}}
\newcommand\basetextual[2]{\par\smallskip{\color{fundo2}\hrule height .5pt}\smallskip
  {\sffamily\scriptsize\color{suave}\textbf{Base AT:} #1\par\textbf{Base NT:} #2\par}}

% Nota / observação
\newtcolorbox{nota}[1][Nota]{EB/base, colback=destaque!4, borderline west={2.5pt}{0pt}{destaque},
  before upper={\EB@rotulo{destaque}{#1}\quad}}
% Pergunta de estudo (numerada por etapa)
\newcounter{pergunta}[chapter]
\renewcommand\thepergunta{\ifnum\value{chapter}>0 \thechapter.\fi\arabic{pergunta}}
\newtcolorbox{pergunta}[1][]{EB/base, colback=fundo, borderline west={2.5pt}{0pt}{destaque2},
  before upper={\refstepcounter{pergunta}\EB@rotulo{destaque2!80!black}{Pergunta \thepergunta}\quad}, #1}
% Alerta metodológico (falácias, cuidados)
\newtcolorbox{alerta}[1][Cuidado]{EB/base, colback=rubrica!5, borderline west={2.5pt}{0pt}{rubrica},
  before upper={\EB@rotulo{rubrica}{#1}\quad}}
% Aplicação
\newtcolorbox{aplicacao}[1][Aplicação]{EB/base, colback=aramaico!6, borderline west={2.5pt}{0pt}{aramaico},
  before upper={\EB@rotulo{aramaico}{#1}\quad}}
% Variante textual
\newtcolorbox{variante}[1][Crítica textual]{EB/base, colback=white, colframe=rubrica!60,
  boxrule=.5pt, before upper={\EB@rotulo{rubrica}{#1}\quad}}
% Citação de obra (comentário, léxico...): \begin{citacao}{Autor, Obra, p.}
\newtcolorbox{citacao}[1]{EB/base, colback=fundo!60, borderline west={1pt}{0pt}{suave},
  fontupper=\itshape, after upper={\par\hfill{\upshape\sffamily\footnotesize\color{suave}— #1}}}
% Verbete lexical: \begin{lexico}{lema}{Strong}{nº no NT}
\newtcolorbox{lexico}[3]{EB/base, colback=white, colframe=grego!35, boxrule=.5pt,
  colbacktitle=grego!6, coltitle=tinta, toptitle=3pt, bottomtitle=3pt,
  title={{\EBfgrego\large\color{grego}\mdseries #1}\enspace\trgr{#1}\hfill
         {\mdseries\color{suave}#2\ifblank{#3}{}{\enspace·\enspace #3× no NT}}},
  before upper={\EBindexlema{grego}{\directlua{tex.sprint(EB.chave("\luaescapestring{#1}"))}}{#1}}}
\newcommand\lexicoref[1]{\EBindexlema{grego}{\directlua{tex.sprint(EB.chave("\luaescapestring{#1}"))}}{#1}}

